# Local-only values for the controlled ReleaseGuard lab.
# Supply a strong JWT_SECRET and disable test controls outside this environment.
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://releaseguard:releaseguard_dev@localhost:5433/releaseguard
JWT_EXPIRES_IN=1h
JWT_SECRET=releaseguard-local-only-secret-change-me
ENABLE_TEST_CONTROLS=true
PAYMENT_PROVIDER_MAX_ATTEMPTS=2
PAYMENT_PROVIDER_TIMEOUT_MS=250
PAYMENT_PROVIDER_URL=http://localhost:4100
PAYMENT_PROVIDER_HOST=0.0.0.0
PAYMENT_PROVIDER_PORT=4100
PAYMENT_SLOW_DELAY_MS=100
PAYMENT_TIMEOUT_DELAY_MS=650
VITE_API_URL=http://localhost:4000
