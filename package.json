{
  "name": "releaseguard-sdet",
  "version": "0.1.0",
  "private": true,
  "description": "An SDET and Quality Engineering lab built around a controlled subscription platform.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently --kill-others --names provider,api,web --prefix-colors yellow,cyan,magenta \"npm run dev:provider\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @releaseguard/api",
    "dev:provider": "npm run dev --workspace @releaseguard/payment-provider",
    "dev:web": "npm run dev --workspace @releaseguard/web",
    "db:migrate": "npm run db:migrate --workspace @releaseguard/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:contract && npm run db:migrate && npm run test:unit && playwright test --project=payment-provider --project=api --project=integration --project=ui-chromium --project=accessibility",
    "test:a11y": "npm run db:migrate && playwright test --project=accessibility",
    "test:api": "npm run db:migrate && playwright test --project=api",
    "test:analyze": "node --import tsx packages/test-observability/src/cli.ts",
    "test:contract": "npm run test:contract:consumer && npm run test:contract:provider",
    "test:contract:consumer": "vitest run tests/contract/consumer --no-file-parallelism",
    "test:contract:provider": "vitest run tests/contract/provider --no-file-parallelism",
    "test:integration": "npm run db:migrate && playwright test --project=integration",
    "test:perf": "npm run test:perf:smoke",
    "test:perf:load": "node scripts/run-k6.mjs load",
    "test:perf:smoke": "node scripts/run-k6.mjs smoke",
    "test:provider": "playwright test --project=payment-provider",
    "test:resilience": "npm run db:migrate && playwright test --project=ui-chromium --grep @resilience",
    "test:smoke": "npm run db:migrate && playwright test --project=api --grep @smoke",
    "test:summary": "npm run test:analyze",
    "test:unit": "vitest run tests/unit",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "test:visual:update": "node scripts/run-visual-tests.mjs --update-snapshots",
    "test:ui": "npm run db:migrate && playwright test --project=ui-chromium",
    "test:ui:smoke": "npm run db:migrate && playwright test --project=ui-chromium --grep @smoke",
    "test:ui:regression": "npm run db:migrate && playwright test --project=ui-chromium --grep @regression",
    "test:ui:critical": "npm run db:migrate && playwright test --project=ui-chromium --grep @critical",
    "test:ui:cross-browser": "npm run db:migrate && playwright test --project=ui-chromium --project=ui-firefox-smoke --project=ui-webkit-smoke --grep @smoke",
    "test:ui:firefox:full": "npm run db:migrate && playwright test --project=ui-firefox",
    "test:ui:webkit:full": "npm run db:migrate && playwright test --project=ui-webkit",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:ui:debug": "playwright test --project=ui-chromium --debug",
    "test:report": "playwright show-report",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit --project tsconfig.tests.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^17.1.3",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.9.1",
    "globals": "^16.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
